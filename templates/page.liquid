{% assign home_page = site.pages['/'] %}
{% assign home_style = home_page.template_style | default: 'help_center' %}
{% assign reading_layout = site.settings.article_layout.value | default: 'auto' %}
{% if reading_layout == 'auto' %}
  {% case home_style %}
    {% when 'support' %}{% assign reading_layout = 'support' %}
    {% else %}{% assign reading_layout = 'reader' %}
  {% endcase %}
{% endif %}
{% assign page_layout = page.settings.reading_layout.value | default: 'inherit' %}
{% unless page_layout == 'inherit' %}{% assign reading_layout = page_layout %}{% endunless %}
{% assign child_count = page.children_in_list | size %}
{% case home_style %}
  {% when 'faqs' %}{% assign home_mode = 'faqs' %}
  {% when 'support' %}{% assign home_mode = 'support' %}
  {% else %}{% assign home_mode = 'collections' %}
{% endcase %}

{% if reading_layout == 'support' %}
  {% capture support_markup %}{% render 'support_contact', compact: true %}{% endcapture %}
  {% assign support_markup = support_markup | strip %}
  {% assign topics = home_page.children_in_list %}
  {% assign topic_count = topics | size %}
  {% assign show_aside = false %}
  {% if topic_count > 0 or support_markup != blank %}{% assign show_aside = true %}{% endif %}
  <div class="help-container py-8 lg:py-12" data-controller="toc" data-reading-layout="support">
    <div class="grid items-start gap-10 {% if show_aside %}lg:grid-cols-[minmax(0,1fr)_20rem]{% else %}max-w-3xl{% endif %}">
      <article class="min-w-0">
        <header class="mb-8">
          <h1 class="text-3xl font-semibold tracking-tight text-base-content md:text-4xl">{{ page.settings.title | default: page.link_text | escape_once }}</h1>
          {% assign crumb_count = page.breadcrumb | size %}
          {% if crumb_count > 1 %}
            <div class="mt-3 flex flex-wrap items-center gap-2 text-sm text-primary">
              {% for crumb in page.breadcrumb %}
                {% unless forloop.last %}
                  {% unless forloop.first %}<span class="text-base-content/40" aria-hidden="true">·</span>{% endunless %}
                  <a href="{{ crumb.path }}" class="hover:underline">{{ crumb.link_text | escape_once }}</a>
                {% endunless %}
              {% endfor %}
            </div>
          {% endif %}
          {% if page.settings.description != blank %}
            <p class="mt-4 max-w-2xl text-base leading-7 text-base-content/65">{{ page.settings.description | escape_once }}</p>
          {% endif %}
          {% capture article_meta %}
            {% if site.settings.show_author and page.author %}<span>{{ page.author.name | escape_once }}</span>{% endif %}
            {% if site.settings.show_published_at and page.published_at %}<time datetime="{{ page.published_at | date: '%Y-%m-%d' }}">{{ page.published_at | date: '%Y-%m-%d' }}</time>{% endif %}
            {% for tag in page.settings.tags %}<a href="{{ tag.path }}" class="rounded-full bg-base-200 px-2.5 py-1 text-base-content/60 hover:text-primary">{{ tag.name | escape_once }}</a>{% endfor %}
          {% endcapture %}
          {% assign article_meta = article_meta | strip %}
          {% if article_meta != blank %}
            <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-base-content/45">{{ article_meta }}</div>
          {% endif %}
        </header>
        {% render 'reading_toc', inline: true %}
        {% render 'article_body', page: page %}
        {% if child_count > 0 %}
          {% render 'category_content', page: page, home_mode: home_mode %}
        {% endif %}
        {% capture feedback_markup %}{% render 'feedback_form', page: page, plain: true %}{% endcapture %}
        {% capture related_markup %}{% render 'related_articles', page: page, tone: 'primary' %}{% endcapture %}
        {% assign feedback_markup = feedback_markup | strip %}
        {% assign related_markup = related_markup | strip %}
        {% if feedback_markup != blank or related_markup != blank %}
          <div class="mt-12 border-t border-base-300 pt-8">
            {{ feedback_markup }}
            {{ related_markup }}
          </div>
        {% endif %}
      </article>
      {% if show_aside %}
        <aside class="min-w-0 space-y-4 lg:sticky lg:top-24" aria-label="{{ 'reading.all_topics' | t | escape }}">
          {% if topic_count > 0 %}
            <nav class="rounded-2xl bg-base-200 p-6" aria-label="{{ 'reading.all_topics' | t | escape }}">
              <h2 class="text-xs font-semibold uppercase tracking-wider text-base-content/45">{{ 'reading.all_topics' | t }}</h2>
              <ul class="mt-3 space-y-1">
                {% for topic in topics %}
                  {% capture topic_active %}{% if page.path == topic.path %}1{% endif %}{% for crumb in page.breadcrumb %}{% if crumb.path == topic.path %}1{% endif %}{% endfor %}{% endcapture %}
                  <li><a href="{{ topic.path }}" class="block rounded-lg px-3 py-2 text-sm text-primary hover:bg-base-100{% if topic_active contains '1' %} bg-base-100 font-medium{% endif %}" {% if topic_active contains '1' %}aria-current="true"{% endif %}>{{ topic.link_text | escape_once }}</a></li>
                {% endfor %}
              </ul>
            </nav>
          {% endif %}
          {% if support_markup != blank %}{{ support_markup }}{% endif %}
        </aside>
      {% endif %}
    </div>
  </div>
{% else %}
<div class="help-container py-8 lg:py-12" data-controller="toc" data-reading-layout="{{ reading_layout }}">
  {% render 'reading_breadcrumb', page: page %}
  <div class="mt-7 grid gap-10 {% if reading_layout == 'tree' %}lg:grid-cols-[15rem_minmax(0,1fr)] xl:grid-cols-[15rem_minmax(0,1fr)_13rem]{% else %}mx-auto max-w-3xl{% endif %}">
    {% if reading_layout == 'tree' %}
      <aside class="min-w-0">
        <details class="help-card p-4 lg:hidden">
          <summary class="cursor-pointer text-sm font-semibold">{{ 'reading.topics' | t }}</summary>
          <div class="mt-4">{% render 'reading_navigation', page: page, home_page: home_page %}</div>
        </details>
        <div class="hidden lg:sticky lg:top-28 lg:block lg:max-h-[calc(100vh-8rem)] lg:overflow-y-auto lg:pr-3">
          {% render 'reading_navigation', page: page, home_page: home_page %}
        </div>
      </aside>
    {% endif %}

    <article class="min-w-0">
      {% render 'article_header', page: page %}
      {% if reading_layout == 'tree' %}
        <div class="xl:hidden">{% render 'reading_toc', inline: true %}</div>
      {% else %}
        {% render 'reading_toc', inline: true %}
      {% endif %}
      {% render 'article_body', page: page %}
      {% if child_count > 0 %}
        {% render 'category_content', page: page, home_mode: home_mode %}
      {% endif %}
      {% render 'article_footer', page: page %}
    </article>

    {% if reading_layout == 'tree' %}
      <aside class="hidden xl:block">
        <div class="sticky top-28">{% render 'reading_toc' %}</div>
      </aside>
    {% endif %}
  </div>
</div>
{% endif %}

{% schema %}
{
  "name": "t:schema.page.name",
  "description": "t:schema.page.description",
  "sub_page_templates": [
    "page"
  ],
  "context_schema": {
    "key": "help",
    "label": "t:schema.context_schema.label",
    "version": 1,
    "content_types": [
      {
        "key": "article",
        "label": "t:schema.context_schema.types.article.label",
        "templates": [
          "page"
        ],
        "fields": [
          {
            "key": "topics",
            "label": "t:schema.context_schema.types.article.fields.topics.label",
            "type": "tags",
            "policy": "ai_auto"
          },
          {
            "key": "summary",
            "label": "t:schema.context_schema.types.article.fields.summary.label",
            "type": "textarea",
            "policy": "ai_suggest"
          },
          {
            "key": "question",
            "label": "t:schema.context_schema.types.article.fields.question.label",
            "type": "textarea",
            "policy": "ai_suggest"
          },
          {
            "key": "steps",
            "label": "t:schema.context_schema.types.article.fields.steps.label",
            "type": "textarea",
            "policy": "ai_suggest"
          }
        ],
        "relations": [
          {
            "type": "related_to",
            "label": "t:schema.context_schema.types.article.relations.related_to.label",
            "inverse": "related_to",
            "cardinality": "many",
            "policy": "suggest"
          }
        ]
      }
    ]
  },
  "settings": [
    {
      "id": "title",
      "type": "text",
      "readonly": true,
      "label": "t:schema.page.title",
      "to_markdown": true
    },
    {
      "id": "content",
      "type": "richtext",
      "readonly": true,
      "label": "t:schema.page.content",
      "to_markdown": true
    },
    {
      "id": "description",
      "type": "textarea",
      "label": "t:schema.page.summary",
      "to_markdown": true
    },
    {
      "id": "icon_image",
      "type": "image_picker",
      "label": "t:schema.page.icon_image"
    },
    {
      "id": "icon_name",
      "type": "select",
      "label": "t:schema.page.icon_name",
      "default": "book-open",
      "choices": [
        {
          "value": "book-open",
          "label": "t:schema.page.icons.book_open"
        },
        {
          "value": "file-text",
          "label": "t:schema.page.icons.file_text"
        },
        {
          "value": "circle-help",
          "label": "t:schema.page.icons.circle_help"
        },
        {
          "value": "rocket",
          "label": "t:schema.page.icons.rocket"
        },
        {
          "value": "settings",
          "label": "t:schema.page.icons.settings"
        },
        {
          "value": "users",
          "label": "t:schema.page.icons.users"
        },
        {
          "value": "shield-check",
          "label": "t:schema.page.icons.shield_check"
        },
        {
          "value": "credit-card",
          "label": "t:schema.page.icons.credit_card"
        },
        {
          "value": "plug",
          "label": "t:schema.page.icons.plug"
        },
        {
          "value": "layers",
          "label": "t:schema.page.icons.layers"
        },
        {
          "value": "code",
          "label": "t:schema.page.icons.code"
        },
        {
          "value": "package",
          "label": "t:schema.page.icons.package"
        }
      ]
    },
    {
      "id": "reading_layout",
      "type": "select",
      "label": "t:schema.page.reading_layout",
      "default": "inherit",
      "choices": [
        {
          "value": "inherit",
          "label": "t:schema.page.layouts.inherit"
        },
        {
          "value": "tree",
          "label": "t:schema.page.layouts.tree"
        },
        {
          "value": "reader",
          "label": "t:schema.page.layouts.reader"
        },
        {
          "value": "support",
          "label": "t:schema.page.layouts.support"
        }
      ]
    },
    {
      "id": "tags",
      "type": "tag_picker",
      "multiple": true,
      "label": "t:schema.page.tags",
      "queryable": true,
      "to_markdown": true
    },
    {
      "id": "related_pages",
      "type": "textarea",
      "label": "t:schema.page.related_pages",
      "info": "t:schema.page.related_pages_info"
    }
  ]
}
{% endschema %}
