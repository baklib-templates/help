{% assign home_page = site.index_page %}
{% assign home_style = home_page.template_style | default: 'help_center' %}
{% assign reading_layout = site.settings.article_layout.value | default: 'auto' %}
{% if reading_layout == 'auto' %}
  {% case home_style %}
    {% when 'support' %}{% assign reading_layout = 'support' %}
    {% else %}{% assign reading_layout = 'reader' %}
  {% endcase %}
{% endif %}
{% assign page_layout = page.settings.reading_layout.value | default: 'inherit' %}
{% unless page_layout == 'inherit' %}{% assign reading_layout = page_layout %}{% endunless %}
{% assign child_count = page.children_in_list | size %}
{% case home_style %}
  {% when 'faqs' %}{% assign home_mode = 'faqs' %}
  {% when 'support' %}{% assign home_mode = 'support' %}
  {% else %}{% assign home_mode = 'collections' %}
{% endcase %}

{% assign support_markup = '' %}
{% if reading_layout == 'support' %}{% capture support_markup %}{% render 'support_contact', compact: true %}{% endcapture %}{% assign support_markup = support_markup | strip %}{% endif %}

<div class="help-container py-8 lg:py-12" data-controller="toc" data-reading-layout="{{ reading_layout }}">
  {% render 'reading_breadcrumb', page: page %}
  <div class="mt-7 grid gap-10 {% if reading_layout == 'tree' %}lg:grid-cols-[15rem_minmax(0,1fr)] xl:grid-cols-[15rem_minmax(0,1fr)_13rem]{% elsif reading_layout == 'support' and support_markup != blank %}lg:grid-cols-[minmax(0,1fr)_19rem]{% else %}mx-auto max-w-3xl{% endif %}">
    {% if reading_layout == 'tree' %}
      <aside class="min-w-0">
        <details class="help-card p-4 lg:hidden">
          <summary class="cursor-pointer text-sm font-semibold">{{ 'reading.topics' | t }}</summary>
          <div class="mt-4">{% render 'reading_navigation', page: page, home_page: home_page %}</div>
        </details>
        <div class="hidden lg:sticky lg:top-28 lg:block lg:max-h-[calc(100vh-8rem)] lg:overflow-y-auto lg:pr-3">
          {% render 'reading_navigation', page: page, home_page: home_page %}
        </div>
      </aside>
    {% endif %}

    <article class="min-w-0">
      {% render 'article_header', page: page %}
      {% if reading_layout == 'tree' %}
        <div class="xl:hidden">{% render 'reading_toc', inline: true %}</div>
      {% else %}
        {% render 'reading_toc', inline: true %}
      {% endif %}
      {% render 'article_body', page: page %}
      {% if child_count > 0 %}
        {% render 'category_content', page: page, home_mode: home_mode %}
      {% endif %}
      {% render 'article_footer', page: page %}
    </article>

    {% if reading_layout == 'tree' %}
      <aside class="hidden xl:block">
        <div class="sticky top-28">{% render 'reading_toc' %}</div>
      </aside>
    {% elsif reading_layout == 'support' and support_markup != blank %}
      <aside class="min-w-0"><div class="lg:sticky lg:top-28">{{ support_markup }}</div></aside>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "t:schema.page.name",
  "description": "t:schema.page.description",
  "sub_page_templates": [
    "page"
  ],
  "context_schema": {
    "key": "help",
    "label": "t:schema.context_schema.label",
    "version": 1,
    "content_types": [
      {
        "key": "article",
        "label": "t:schema.context_schema.types.article.label",
        "templates": [
          "page"
        ],
        "fields": [
          {
            "key": "topics",
            "label": "t:schema.context_schema.types.article.fields.topics.label",
            "type": "tags",
            "policy": "ai_auto"
          },
          {
            "key": "summary",
            "label": "t:schema.context_schema.types.article.fields.summary.label",
            "type": "textarea",
            "policy": "ai_suggest"
          },
          {
            "key": "question",
            "label": "t:schema.context_schema.types.article.fields.question.label",
            "type": "textarea",
            "policy": "ai_suggest"
          },
          {
            "key": "steps",
            "label": "t:schema.context_schema.types.article.fields.steps.label",
            "type": "textarea",
            "policy": "ai_suggest"
          }
        ],
        "relations": [
          {
            "type": "related_to",
            "label": "t:schema.context_schema.types.article.relations.related_to.label",
            "inverse": "related_to",
            "cardinality": "many",
            "policy": "suggest"
          }
        ]
      }
    ]
  },
  "settings": [
    {
      "id": "title",
      "type": "text",
      "readonly": true,
      "label": "t:schema.page.title",
      "to_markdown": true
    },
    {
      "id": "content",
      "type": "richtext",
      "readonly": true,
      "label": "t:schema.page.content",
      "to_markdown": true
    },
    {
      "id": "description",
      "type": "textarea",
      "label": "t:schema.page.summary",
      "to_markdown": true
    },
    {
      "id": "icon_image",
      "type": "image_picker",
      "label": "t:schema.page.icon_image"
    },
    {
      "id": "icon_name",
      "type": "select",
      "label": "t:schema.page.icon_name",
      "default": "book-open",
      "choices": [
        {
          "value": "book-open",
          "label": "t:schema.page.icons.book_open"
        },
        {
          "value": "file-text",
          "label": "t:schema.page.icons.file_text"
        },
        {
          "value": "circle-help",
          "label": "t:schema.page.icons.circle_help"
        },
        {
          "value": "rocket",
          "label": "t:schema.page.icons.rocket"
        },
        {
          "value": "settings",
          "label": "t:schema.page.icons.settings"
        },
        {
          "value": "users",
          "label": "t:schema.page.icons.users"
        },
        {
          "value": "shield-check",
          "label": "t:schema.page.icons.shield_check"
        },
        {
          "value": "credit-card",
          "label": "t:schema.page.icons.credit_card"
        },
        {
          "value": "plug",
          "label": "t:schema.page.icons.plug"
        },
        {
          "value": "layers",
          "label": "t:schema.page.icons.layers"
        },
        {
          "value": "code",
          "label": "t:schema.page.icons.code"
        },
        {
          "value": "package",
          "label": "t:schema.page.icons.package"
        }
      ]
    },
    {
      "id": "reading_layout",
      "type": "select",
      "label": "t:schema.page.reading_layout",
      "default": "inherit",
      "choices": [
        {
          "value": "inherit",
          "label": "t:schema.page.layouts.inherit"
        },
        {
          "value": "tree",
          "label": "t:schema.page.layouts.tree"
        },
        {
          "value": "reader",
          "label": "t:schema.page.layouts.reader"
        },
        {
          "value": "support",
          "label": "t:schema.page.layouts.support"
        }
      ]
    },
    {
      "id": "tags",
      "type": "tag_picker",
      "multiple": true,
      "label": "t:schema.page.tags",
      "queryable": true,
      "to_markdown": true
    },
    {
      "id": "video_url",
      "type": "video_picker",
      "label": "t:schema.page.video",
      "ratio": "16:9"
    },
    {
      "id": "related_pages",
      "type": "textarea",
      "label": "t:schema.page.related_pages",
      "info": "t:schema.page.related_pages_info"
    }
  ]
}
{% endschema %}
