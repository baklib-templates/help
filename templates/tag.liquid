<section class="help-container max-w-4xl py-10 lg:py-14">
  <a href="{{ site.index_path }}" class="inline-flex items-center gap-2 text-sm text-base-content/50 hover:text-primary">{% render 'icon', name: 'arrow-left', class: 'size-4' %}{{ 'reading.browse_topics' | t }}</a>
  <header class="mb-9 mt-7"><p class="mb-3 text-xs font-semibold uppercase tracking-widest text-primary">{{ 'reading.tagged_articles' | t }}</p><h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">{{ tag.name | escape_once }}</h1></header>
  {% paginate_tag tag.pages, as: 'items', per: 18 %}
    {% assign item_count = items | size %}
    {% if item_count > 0 %}<div class="divide-y divide-base-300">{% for item in items %}{% render 'category_item', item: item %}{% endfor %}</div>{% else %}<p class="help-card p-8 text-base-content/55">{{ 'reading.no_tagged_articles' | t }}</p>{% endif %}
    {% render 'reading_pagination', paginate: paginate %}
  {% endpaginate_tag %}
</section>
