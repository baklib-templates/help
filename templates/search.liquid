{% assign ai_enabled = false %}
{% if site.ai_search_enabled? and site.settings.enable_ai_search %}{% assign ai_enabled = true %}{% endif %}
<div class="help-container py-10 lg:py-14">
  <header class="max-w-3xl"><p class="mb-3 text-xs font-semibold uppercase tracking-widest text-primary">{{ 'reading.search_eyebrow' | t }}</p><h1 class="mb-6 text-3xl font-semibold tracking-tight sm:text-4xl">{{ 'reading.search_title' | t }}</h1>{% render 'search_form', id: 'results-search', keywords: search.keywords %}</header>
  <div class="mt-10 grid gap-10 {% if ai_enabled %}lg:grid-cols-[minmax(0,1fr)_22rem]{% else %}max-w-3xl{% endif %}">
    <section class="min-w-0">
      {% if search.keywords != blank or search.tag %}
        {% paginate_tag search.pages, as: 'items', per: 15 %}
          {% assign show_extends = false %}{% if search.page_number == 1 %}{% assign show_extends = true %}{% endif %}
          {% assign result_count = items | size %}
          {% if show_extends %}{% assign extra_count = search.extends | size %}{% assign result_count = result_count | plus: extra_count %}{% endif %}
          {% if result_count > 0 %}
            <p class="mb-6 text-sm text-base-content/55">{{ 'reading.results_for' | t }} <strong class="font-medium text-base-content">{{ search.keywords | escape_once }}</strong></p>
            {% render 'search_results', items: items, extends: search.extends, show_extends: show_extends %}
            {% render 'reading_pagination', paginate: paginate %}
          {% else %}
            <div class="help-card px-6 py-10"><h2 class="text-lg font-semibold">{{ 'reading.no_results' | t }}</h2><p class="mt-2 text-sm leading-6 text-base-content/55">{{ 'reading.no_results_hint' | t }}</p><a href="{{ site.index_path }}" class="help-button mt-5">{{ 'reading.browse_topics' | t }}</a></div>
          {% endif %}
        {% endpaginate_tag %}
      {% else %}
        <div class="rounded-2xl bg-base-200/50 p-8"><h2 class="text-lg font-semibold">{{ 'reading.start_search' | t }}</h2><p class="mt-2 text-sm text-base-content/55">{{ 'reading.start_search_hint' | t }}</p></div>
      {% endif %}
    </section>
    {% if ai_enabled %}<aside class="min-w-0"><div class="lg:sticky lg:top-28">{% render 'ai_search', keywords: search.keywords %}</div></aside>{% endif %}
  </div>
</div>
