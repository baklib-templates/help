[
  {
    "name": "theme_info",
    "theme_name": "help",
    "theme_label": "t:schema.theme.title",
    "theme_description": "t:schema.theme.description",
    "theme_version": "3.0.1",
    "theme_syntax_version": "v2",
    "theme_scope": "wiki",
    "theme_author": "Baklib",
    "theme_languages": [
      {
        "name": "简体中文",
        "value": "zh-CN"
      },
      {
        "name": "English",
        "value": "en"
      }
    ],
    "recommendations": {
      "color_schemas": {
        "calm": {
          "name": "Calm · 沉静",
          "colors": {
            "--theme-color-primary": "#0f766e",
            "--theme-color-primary-content": "#ffffff",
            "--theme-color-secondary": "#334155",
            "--theme-color-accent": "#0f766e",
            "--theme-color-primary-dark": "#5eead4",
            "--theme-color-primary-content-dark": "#102523"
          }
        }
      }
    },
    "theme_thumb_url": "images/theme/cover.jpg",
    "theme_preview_images": [
      "images/theme/home-collections.jpg",
      "images/theme/article-reader.jpg",
      "images/theme/article-mobile.jpg"
    ]
  },
  {
    "name": "t:schema.theme.brand",
    "settings": [
      {
        "id": "logo_url",
        "type": "image_picker",
        "label": "t:schema.theme.logo_url",
        "ratio": "3:1",
        "width": 240
      },
      {
        "id": "brand_name",
        "type": "text",
        "label": "t:schema.theme.brand_name"
      },
      {
        "id": "tagline",
        "type": "text",
        "label": "t:schema.theme.tagline",
        "default": "t:schema.theme.tagline_default"
      },
      {
        "id": "header_link_label",
        "type": "text",
        "label": "t:schema.theme.header_link_label",
        "default": "t:schema.theme.header_link_label_default"
      },
      {
        "id": "header_link_url",
        "type": "text",
        "label": "t:schema.theme.header_link_url",
        "default": "https://example.com"
      },
      {
        "id": "footer_text",
        "type": "text",
        "label": "t:schema.theme.footer_text",
        "default": "t:schema.theme.footer_text_default"
      },
      {
        "id": "show_primary_nav",
        "type": "checkbox",
        "label": "t:schema.theme.show_primary_nav",
        "default": true
      }
    ]
  },
  {
    "name": "t:schema.theme.reading",
    "settings": [
      {
        "id": "article_layout",
        "type": "select",
        "label": "t:schema.theme.article_layout",
        "default": "auto",
        "choices": [
          {
            "value": "auto",
            "label": "t:schema.theme.article_layout_auto"
          },
          {
            "value": "tree",
            "label": "t:schema.theme.article_layout_tree"
          },
          {
            "value": "reader",
            "label": "t:schema.theme.article_layout_reader"
          },
          {
            "value": "support",
            "label": "t:schema.theme.article_layout_support"
          }
        ]
      },
      {
        "id": "category_layout",
        "type": "select",
        "label": "t:schema.theme.category_layout",
        "default": "auto",
        "choices": [
          {
            "value": "auto",
            "label": "t:schema.theme.category_layout_auto"
          },
          {
            "value": "cards",
            "label": "t:schema.theme.category_layout_cards"
          },
          {
            "value": "list",
            "label": "t:schema.theme.category_layout_list"
          },
          {
            "value": "faq",
            "label": "t:schema.theme.category_layout_faq"
          }
        ]
      }
    ]
  },
  {
    "name": "t:schema.theme.support",
    "settings": [
      {
        "id": "support_title",
        "type": "text",
        "label": "t:schema.theme.support_title",
        "default": "t:schema.theme.support_title_default"
      },
      {
        "id": "support_description",
        "type": "textarea",
        "rows": 3,
        "label": "t:schema.theme.support_description",
        "default": "t:schema.theme.support_description_default"
      },
      {
        "id": "support_url",
        "type": "text",
        "label": "t:schema.theme.support_url",
        "default": "https://example.com/contact"
      },
      {
        "id": "support_email",
        "type": "text",
        "label": "t:schema.theme.support_email",
        "default": "support@example.com"
      },
      {
        "id": "support_phone",
        "type": "text",
        "label": "t:schema.theme.support_phone",
        "default": "400-000-0000"
      }
    ]
  },
  {
    "name": "t:schema.theme.content",
    "settings": [
      {
        "id": "show_author",
        "type": "checkbox",
        "label": "t:schema.theme.show_author",
        "default": false
      },
      {
        "id": "show_published_at",
        "type": "checkbox",
        "label": "t:schema.theme.show_published_at",
        "default": false
      },
      {
        "id": "enable_ai_search",
        "type": "checkbox",
        "label": "t:schema.theme.enable_ai_search",
        "default": true
      },
      {
        "id": "show_related_articles",
        "type": "checkbox",
        "label": "t:schema.theme.show_related_articles",
        "default": true
      },
      {
        "id": "show_feedback_form",
        "type": "checkbox",
        "label": "t:schema.theme.show_feedback_form",
        "default": false
      }
    ]
  }
]
