{% assign feedback_title = 'reading.was_helpful' | t %}
{% assign feedback_title = site.plugins.feedback.useful_label | default: feedback_title %}
<div id="help-feedback-{{ page.id }}">
  {% form_tag 'feedback', page, class: 'help-card bg-base-200/40 p-5 sm:p-6' %}
    <fieldset>
      <legend class="mb-4 text-sm font-semibold">{{ feedback_title | escape_once }}</legend>
      {% if success %}<p class="mb-4 text-sm text-success" role="status">{{ success | escape_once }}</p>{% elsif page.visitor_posted_feedback %}<p class="mb-4 text-xs text-base-content/55">{{ 'reading.feedback_recorded' | t }}</p>{% endif %}
      <div id="help-feedback-errors" role="alert" class="mb-3 text-sm text-error"></div>
      <div class="flex flex-wrap gap-3">
        {% for useful_type in site.plugins.feedback.useful_types %}
          {% if site.plugins.feedback.message_enabled %}
            <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-base-300 bg-base-100 px-3 py-2 text-sm hover:border-primary/50">
              <input type="radio" name="{{ form.feedback_emoji_field_name }}" value="{{ useful_type.emoji | escape_once }}" class="accent-primary" required {% if page.visitor_posted_feedback.emoji == useful_type.emoji %}checked{% endif %}>
              <span aria-hidden="true">{{ useful_type.emoji }}</span><span>{{ useful_type.label }}</span>
            </label>
          {% else %}
            <button type="submit" name="{{ form.feedback_emoji_field_name }}" value="{{ useful_type.emoji | escape_once }}" class="help-button" {% if page.visitor_posted_feedback.emoji == useful_type.emoji %}aria-pressed="true"{% else %}aria-pressed="false"{% endif %}><span aria-hidden="true">{{ useful_type.emoji }}</span>{{ useful_type.label }}</button>
          {% endif %}
        {% endfor %}
      </div>
      {% if site.plugins.feedback.message_enabled %}
        <label for="help-feedback-message-{{ page.id }}" class="mt-5 block text-sm text-base-content/65">{{ 'reading.feedback_message' | t }}{% if site.plugins.feedback.message_required %}<span aria-hidden="true"> *</span>{% endif %}</label>
        <textarea id="help-feedback-message-{{ page.id }}" name="{{ form.feedback_message_field_name }}" rows="3" class="mt-2 w-full rounded-xl border border-base-300 bg-base-100 p-3 text-sm outline-none focus:border-primary focus:ring-2 focus:ring-primary/10" placeholder="{{ 'reading.feedback_placeholder' | t }}" {% if site.plugins.feedback.message_required %}required{% endif %}>{{ page.visitor_posted_feedback.message | escape_once }}</textarea>
        <button type="submit" class="help-button mt-3">{{ 'reading.submit_feedback' | t }}</button>
      {% endif %}
    </fieldset>
  {% endform_tag %}
</div>
