<style>
  :root {
    color-scheme: light;
    --color-base-100: hsl(var(--theme-color-base-100, 0 0% 100%));
    --color-base-200: hsl(var(--theme-color-base-200, 210 25% 98%));
    --color-base-300: hsl(var(--theme-color-base-300, 213 19% 90%));
    --color-base-content: hsl(var(--theme-color-base-content, 220 29% 16%));
    --color-primary: hsl(var(--theme-color-primary, 195 82% 35%));
    --color-primary-content: hsl(var(--theme-color-primary-content, 0 0% 100%));
    --color-secondary: hsl(var(--theme-color-secondary, 215 25% 36%));
    --color-secondary-content: hsl(var(--theme-color-secondary-content, 0 0% 100%));
    --color-accent: hsl(var(--theme-color-accent, 172 57% 34%));
    --color-accent-content: hsl(var(--theme-color-accent-content, 0 0% 100%));
    --color-neutral: hsl(var(--theme-color-neutral, 221 25% 18%));
    --color-neutral-content: hsl(var(--theme-color-neutral-content, 210 25% 96%));
    --color-info: hsl(var(--theme-color-info, 200 70% 42%));
    --color-info-content: hsl(var(--theme-color-info-content, 0 0% 100%));
    --color-success: hsl(var(--theme-color-success, 155 55% 33%));
    --color-success-content: hsl(var(--theme-color-success-content, 0 0% 100%));
    --color-warning: hsl(var(--theme-color-warning, 40 90% 56%));
    --color-warning-content: hsl(var(--theme-color-warning-content, 30 60% 15%));
    --color-error: hsl(var(--theme-color-error, 355 65% 47%));
    --color-error-content: hsl(var(--theme-color-error-content, 0 0% 100%));
  }
  [data-theme="dark"] {
    color-scheme: dark;
    --color-base-100: hsl(var(--theme-color-base-100-dark, 220 19% 9%));
    --color-base-200: hsl(var(--theme-color-base-200-dark, 220 18% 12%));
    --color-base-300: hsl(var(--theme-color-base-300-dark, 219 17% 21%));
    --color-base-content: hsl(var(--theme-color-base-content-dark, 210 24% 94%));
    --color-primary: hsl(var(--theme-color-primary-dark, 191 72% 58%));
    --color-primary-content: hsl(var(--theme-color-primary-content-dark, 218 30% 10%));
    --color-secondary: hsl(var(--theme-color-secondary-dark, 210 25% 76%));
    --color-secondary-content: hsl(var(--theme-color-secondary-content-dark, 220 25% 12%));
    --color-accent: hsl(var(--theme-color-accent-dark, 169 60% 62%));
    --color-accent-content: hsl(var(--theme-color-accent-content-dark, 172 40% 10%));
    --color-neutral: hsl(var(--theme-color-neutral-dark, 219 17% 23%));
    --color-neutral-content: hsl(var(--theme-color-neutral-content-dark, 210 25% 96%));
    --color-info: hsl(var(--theme-color-info-dark, 198 75% 65%));
    --color-info-content: hsl(var(--theme-color-info-content-dark, 215 35% 12%));
    --color-success: hsl(var(--theme-color-success-dark, 151 55% 60%));
    --color-success-content: hsl(var(--theme-color-success-content-dark, 155 35% 10%));
    --color-warning: hsl(var(--theme-color-warning-dark, 40 85% 63%));
    --color-warning-content: hsl(var(--theme-color-warning-content-dark, 30 60% 15%));
    --color-error: hsl(var(--theme-color-error-dark, 354 75% 72%));
    --color-error-content: hsl(var(--theme-color-error-content-dark, 350 50% 12%));
  }
</style>
