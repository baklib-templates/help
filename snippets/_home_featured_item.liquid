<a href="{{ item.path }}" class="group flex min-w-0 items-start gap-4 border-b border-base-300 py-5 transition hover:text-primary">
  <span class="mt-0.5 flex size-10 shrink-0 items-center justify-center rounded-xl bg-base-200 text-base-content/50 transition group-hover:bg-primary/10 group-hover:text-primary">{% render 'icon', name: 'book', class: 'size-4' %}</span>
  <span class="min-w-0 flex-1">
    <span class="block font-medium leading-6">{{ item.link_text | escape_once }}</span>
    {% assign item_description = item.settings.description | default: item.seo_description %}
    {% if item_description != blank %}<span class="mt-1 block line-clamp-2 text-sm leading-6 text-base-content/55">{{ item_description | strip_html | escape_once }}</span>{% endif %}
    {% if item.parent != blank %}<span class="mt-2 block text-xs text-base-content/40">{{ item.parent.link_text | escape_once }}</span>{% endif %}
  </span>
  <span class="mt-1 shrink-0 text-base-content/30 transition group-hover:translate-x-1 group-hover:text-primary">{% render 'icon', name: 'arrow-right', class: 'size-4' %}</span>
</a>
