{%- assign header_menu_html = site.settings.header_menu_html -%}
<div class="drawer help-drawer-mobile-only">
  <input id="header-drawer-left" type="checkbox" class="drawer-toggle" x-init="$el.checked = false;" />
  <div class="drawer-content">
    <label for="header-drawer-left" class="drawer-button btn btn-ghost px-2" aria-label="Menu">
      {% render 'icon', name: 'menu', class: 'size-6' %}
    </label>
  </div>
  <div class="drawer-side z-[999]">
    <label
      for="header-drawer-left"
      aria-label="close sidebar"
      class="drawer-overlay"
    ></label>
    <div class="min-h-full w-90 bg-base-200 text-base-content">
      <div class="card flex h-dvh flex-col rounded-l-none bg-base-100 py-4">
        <div class="flex flex-none items-center justify-center space-x-2 px-4">
          {% render 'header_logo' %}
          <span class="text-xl font-bold md:hidden">{{ site.name }}</span>
        </div>

        {% if header_menu_html %}
          <div class="flex flex-col space-y-2 border-t border-base-300 px-4 pt-4 underline">
            {{ header_menu_html }}
          </div>
        {% endif %}

        <div
          class="custom-menu mt-4 min-h-0 flex-1 overflow-y-auto border-t border-base-300 pt-2"
          @click="if($event.target.closest('a')) $event.target.closest('.drawer').querySelector('#header-drawer-left').checked = false"
        >
          <turbo-frame id="page_nav_tree_frame__" src="{{ statics['page/nav_tree'] }}" loading="lazy" class="w-full">
            <div class="flex h-20 w-full items-center justify-center text-base-content/60">
              <span class="loading loading-spinner loading-md text-primary"></span>
            </div>
          </turbo-frame>
        </div>

        <div class="flex-none border-t border-base-300 px-4 py-3">
          {% comment %} Drawer uses base surface; reuse docs-style tones via inline classes in a compact footer {% endcomment %}
          {% assign can_baklib_login = site.baklib_login_enabled %}
          {% assign can_sso_login = site.sso_login_enabled %}
          {% if current_user %}
            <div class="flex items-center gap-3">
              {% if current_user.image %}
                <img src="{{ current_user.image }}" alt="" class="size-8 rounded-field object-cover" width="32" height="32">
              {% else %}
                <span class="flex size-8 items-center justify-center rounded-field bg-base-200 text-base-content/60">
                  {% render 'icon', name: 'user', class: 'size-4' %}
                </span>
              {% endif %}
              <div class="min-w-0 flex-1">
                <div class="truncate text-sm font-medium">{{ current_user.name }}</div>
                <a href="{{ current_user.profile_url }}" class="text-xs text-base-content/60 hover:text-primary">{{ 'snippets.header_user_account.profile' | t: '个人信息' }}</a>
              </div>
              {% form_tag 'sign_out' %}
                <button type="submit" class="btn btn-ghost btn-sm" data-disable-with='{{ "snippets.header_user_account.signout_loading" | t: "退出中..." }}'>
                  {{ 'generic.buttons.signout' | t: '退出登录' }}
                </button>
              {% endform_tag %}
            </div>
          {% elsif can_baklib_login %}
            <div class="flex items-center justify-between gap-2">
              {% form_tag 'sign_in_with_baklib', class: 'min-w-0' %}
                <input type="hidden" name="sign_up" value="true">
                <button type="submit" class="btn btn-ghost btn-sm h-9 min-h-9 px-2 font-normal text-base-content/70" data-disable-with='{{ "snippets.header_user_account.signin_loading" | t: "登录中..." }}'>
                  {{ 'snippets.header_user_account.create_account' | t: '创建账户' }}
                </button>
              {% endform_tag %}
              {% form_tag 'sign_in_with_baklib', class: 'shrink-0' %}
                <button type="submit" class="btn btn-outline btn-sm h-9 min-h-9 border-base-content/20 px-4 font-normal text-base-content/80" data-disable-with='{{ "snippets.header_user_account.signin_loading" | t: "登录中..." }}'>
                  {{ 'snippets.header_user_account.signin' | t: '登录' }}
                </button>
              {% endform_tag %}
            </div>
          {% elsif can_sso_login %}
            {% form_tag 'sign_in_with_sso', class: 'w-full' %}
              <button type="submit" class="btn btn-outline btn-sm h-9 min-h-9 w-full border-base-content/20 font-normal text-base-content/80" data-disable-with='{{ "snippets.header_user_account.signin_loading" | t: "登录中..." }}'>
                {{ 'snippets.header_user_account.signin' | t: '登录' }}
              </button>
            {% endform_tag %}
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>
