{%- if site.settings.support_url != blank or site.settings.support_email != blank or site.settings.support_phone != blank -%}
  <section class="help-card {% if compact %}p-6{% else %}flex flex-col gap-6 p-7 sm:flex-row sm:items-center sm:justify-between md:p-9{% endif %}">
    <div class="{% if compact %}mb-6{% else %}max-w-xl{% endif %}">
      <span class="mb-4 inline-flex size-10 items-center justify-center rounded-xl bg-base-200 text-base-content/70">{% render 'icon', name: 'headphones', class: 'size-5' %}</span>
      <h2 class="text-xl font-semibold tracking-tight">{% if site.settings.support_title != blank %}{{ site.settings.support_title | escape_once }}{% else %}{{ 'shell.support_title' | t }}{% endif %}</h2>
      <p class="mt-2 text-sm leading-7 text-base-content/60">{% if site.settings.support_description != blank %}{{ site.settings.support_description | escape_once }}{% else %}{{ 'shell.support_description' | t }}{% endif %}</p>
    </div>
    <div class="flex shrink-0 {% if compact %}flex-col{% else %}flex-wrap{% endif %} gap-3">
      {% if site.settings.support_url != blank %}<a href="{{ site.settings.support_url | escape_once }}" class="help-button">{{ 'shell.contact_support' | t }}{% render 'icon', name: 'arrow-up-right', class: 'size-4' %}</a>{% endif %}
      {% if site.settings.support_email != blank %}<a href="mailto:{{ site.settings.support_email | escape_once }}" class="help-button">{% render 'icon', name: 'mail', class: 'size-4' %}{{ 'shell.email_support' | t }}</a>{% endif %}
      {% if site.settings.support_phone != blank %}<a href="tel:{{ site.settings.support_phone | escape_once }}" class="help-button">{% render 'icon', name: 'phone', class: 'size-4' %}{{ site.settings.support_phone | escape_once }}</a>{% endif %}
    </div>
  </section>
{%- endif -%}
