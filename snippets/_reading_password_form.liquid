{% form_tag 'sign_in_with_password', id: 'js--sign-in-form', class: 'space-y-3' %}
  <label for="help-page-password" class="block text-sm font-medium">{{ 'reading.password' | t }}</label>
  <input id="help-page-password" type="password" name="{{ form.password_field_name }}" autocomplete="current-password" required class="w-full rounded-xl border border-base-300 bg-base-100 px-4 py-3 outline-none focus:border-primary focus:ring-2 focus:ring-primary/10">
  {% if form.error_message != blank %}<p role="alert" class="text-sm text-error">{{ form.error_message | escape_once }}</p>{% endif %}
  <button type="submit" class="help-button w-full">{{ 'reading.unlock' | t }}</button>
{% endform_tag %}
