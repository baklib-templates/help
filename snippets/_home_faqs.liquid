{% assign faq_source_path = home.settings.faq_source | strip %}
{% assign faq_source = root %}
{% if faq_source_path != blank %}{% assign faq_source = site.pages[faq_source_path] %}{% endif %}
{% assign faq_items = faq_source.children_in_list %}
{% assign faq_count = faq_items | size %}

<section class="help-section" aria-labelledby="home-faq-title">
  <div class="grid gap-7 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.6fr)] lg:gap-14">
    <div>
      <p class="help-eyebrow mb-2 text-base-content/45">{{ 'home.faq_eyebrow' | t }}</p>
      <h2 id="home-faq-title" class="text-2xl font-semibold tracking-tight text-base-content md:text-3xl">{{ 'home.faq_title' | t }}</h2>
      <p class="mt-3 text-sm leading-6 text-base-content/60">{{ 'home.faq_description' | t }}</p>
      {% if faq_source != blank and faq_source.id != root.id %}
        <a href="{{ faq_source.path }}" class="mt-5 inline-flex min-h-10 items-center gap-2 text-sm font-medium text-primary underline-offset-4 hover:underline">{{ 'home.view_all_answers' | t }}{% render 'icon', name: 'arrow-right', class: 'size-4' %}</a>
      {% endif %}
    </div>
    <div class="min-w-0">
      {% if faq_count > 0 %}
        <div class="overflow-hidden rounded-2xl border border-base-300 bg-base-100">
          {% for item in faq_items limit: 8 %}
            {% assign item_children = item.children_in_list %}
            {% assign item_child_count = item_children | size %}
            {% assign item_accessible = item | can_access? %}
            {% assign answer = '' %}
            {% if item_accessible and item_child_count == 0 %}
              {% assign answer = item.settings.description | default: item.settings.content | strip_html | strip %}
            {% endif %}
            {% if item_child_count > 0 or answer == blank %}
              <a href="{{ item.path }}" class="group flex items-center gap-4 border-b border-base-300 px-5 py-5 last:border-b-0 sm:px-6">
                <span class="min-w-0 flex-1">
                  <span class="block font-medium leading-6 text-base-content transition group-hover:text-primary">{{ item.link_text | escape_once }}</span>
                  <span class="mt-1 block text-xs text-base-content/50">{% if item_child_count > 0 %}{{ 'home.browse_topic' | t }}{% else %}{{ 'home.read_answer' | t }}{% endif %}</span>
                </span>
                <span class="shrink-0 text-base-content/35 transition group-hover:text-primary">{% render 'icon', name: 'arrow-right', class: 'size-4' %}</span>
              </a>
            {% else %}
              <details class="group border-b border-base-300 last:border-b-0">
                <summary class="flex cursor-pointer list-none items-center gap-4 px-5 py-5 marker:hidden sm:px-6 [&::-webkit-details-marker]:hidden">
                  <span class="min-w-0 flex-1 font-medium leading-6 text-base-content">{{ item.link_text | escape_once }}</span>
                  <span class="flex size-6 shrink-0 rotate-90 items-center justify-center rounded-full bg-base-200 text-base-content/50 transition group-open:-rotate-90">{% render 'icon', name: 'arrow-right', class: 'size-3.5' %}</span>
                </summary>
                <div class="px-5 pb-6 sm:px-6">
                  <p class="max-w-prose text-sm leading-7 text-base-content/65">{{ answer | truncate: 320 | escape_once }}</p>
                  <a href="{{ item.path }}" class="mt-4 inline-flex min-h-9 items-center gap-2 text-sm font-medium text-primary underline-offset-4 hover:underline">{{ 'home.read_answer' | t }}{% render 'icon', name: 'arrow-right', class: 'size-4' %}</a>
                </div>
              </details>
            {% endif %}
          {% endfor %}
        </div>
      {% else %}
        <div class="rounded-2xl border border-dashed border-base-300 bg-base-200/30 p-8">
          <p class="font-medium text-base-content">{{ 'home.faq_empty_title' | t }}</p>
          <p class="mt-2 text-sm leading-6 text-base-content/60">{{ 'home.faq_empty_description' | t }}</p>
        </div>
      {% endif %}
    </div>
  </div>
</section>
