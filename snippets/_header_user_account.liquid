{% comment %}
  Header user account for Help theme (neutral header bar).
  Place next to custom header_menu_html.
{% endcomment %}
{% assign can_baklib_login = site.baklib_login_enabled %}
{% assign can_sso_login = site.sso_login_enabled %}
{% assign header_icon_btn = header_icon_btn | default: 'inline-flex size-10 shrink-0 cursor-pointer items-center justify-center rounded-field p-1 text-neutral-content/70 hover:bg-neutral-content/10 hover:text-neutral-content' %}

{% if current_user %}
  <span class="hidden h-6 w-px shrink-0 bg-neutral-content/20 sm:block" aria-hidden="true"></span>
  <div class="flex shrink-0 items-center">
    <div class="dropdown dropdown-end">
      <div tabindex="0" role="button" class="{{ header_icon_btn }}" aria-label="{{ 'snippets.header_user_account.user_center' | t: '个人中心' | escape_once }}">
        {% if current_user.image %}
          <img src="{{ current_user.image }}" alt="" class="size-7 rounded-field object-cover sm:size-8" width="32" height="32">
        {% else %}
          {% render 'icon', name: 'user', class: 'size-4 sm:size-[1.125rem]' %}
        {% endif %}
      </div>
      <div tabindex="0" class="dropdown-content mt-2 w-48 space-y-1 rounded-box border border-base-300 bg-base-100 px-2 py-2 shadow-sm">
        <div class="line-clamp-1 border-b border-base-200 px-2 pb-2 text-sm font-medium text-accent">
          {{ current_user.name }}
        </div>
        <a
          href="{{ current_user.profile_url }}"
          class="flex items-center gap-2 rounded-lg px-2 py-2 text-sm text-base-content/80 hover:bg-base-200"
        >
          {{ 'snippets.header_user_account.profile' | t: '个人信息' }}
        </a>
        {% form_tag 'sign_out' %}
          <button
            type="submit"
            class="flex w-full items-center gap-2 rounded-lg px-2 py-2 text-left text-sm text-error hover:bg-base-200"
            data-disable-with='{{ "snippets.header_user_account.signout_loading" | t: "退出中..." }}'
          >
            {{ 'generic.buttons.signout' | t: '退出登录' }}
          </button>
        {% endform_tag %}
      </div>
    </div>
  </div>
{% elsif can_baklib_login %}
  <div class="flex shrink-0 items-center gap-1 sm:gap-2">
    {% form_tag 'sign_in_with_baklib' %}
      <input type="hidden" name="sign_up" value="true">
      <button
        type="submit"
        class="btn btn-ghost btn-sm h-9 min-h-9 px-2 font-normal text-neutral-content/75 hover:bg-neutral-content/10 hover:text-neutral-content"
        data-disable-with='{{ "snippets.header_user_account.signin_loading" | t: "登录中..." }}'
      >
        {{ 'snippets.header_user_account.create_account' | t: '创建账户' }}
      </button>
    {% endform_tag %}
    {% form_tag 'sign_in_with_baklib' %}
      <button
        type="submit"
        class="btn btn-outline btn-sm h-9 min-h-9 border-neutral-content/30 px-3 font-normal text-neutral-content hover:border-neutral-content/50 hover:bg-neutral-content/10"
        data-disable-with='{{ "snippets.header_user_account.signin_loading" | t: "登录中..." }}'
      >
        {{ 'snippets.header_user_account.signin' | t: '登录' }}
      </button>
    {% endform_tag %}
  </div>
{% elsif can_sso_login %}
  {% form_tag 'sign_in_with_sso' %}
    <button
      type="submit"
      class="btn btn-outline btn-sm h-9 min-h-9 border-neutral-content/30 px-3 font-normal text-neutral-content hover:border-neutral-content/50 hover:bg-neutral-content/10"
      data-disable-with='{{ "snippets.header_user_account.signin_loading" | t: "登录中..." }}'
    >
      {{ 'snippets.header_user_account.signin' | t: '登录' }}
    </button>
  {% endform_tag %}
{% endif %}
