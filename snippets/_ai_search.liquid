<section class="help-card overflow-hidden" data-controller="ai-search" data-ai-search-url-value="{{ script_name }}/-/ai-search-completion" data-ai-search-thinking-value="{{ 'reading.ai_thinking' | t }}" data-ai-search-error-value="{{ 'reading.ai_error' | t }}" data-ai-search-completed-value="{{ 'reading.ai_completed' | t }}" data-ai-search-empty-value="{{ 'reading.ai_empty' | t }}">
  <div class="border-b border-base-300 bg-primary/5 p-5"><h2 class="flex items-center gap-2 text-sm font-semibold">{% render 'icon', name: 'sparkles', class: 'size-4 text-primary' %}{{ 'reading.ai_title' | t }}</h2><p class="mt-2 text-xs leading-5 text-base-content/55">{{ 'reading.ai_description' | t }}</p></div>
  <div class="p-5"><div class="mb-4 max-h-96 help-prose overflow-y-auto break-words text-sm leading-7 text-base-content/80" data-ai-search-target="output"></div><p role="status" aria-live="polite" class="mb-3 text-xs leading-5 text-base-content/50" data-ai-search-target="status"></p>
    <form data-action="submit->ai-search#submit"><label for="help-ai-question" class="sr-only">{{ 'reading.ai_question' | t }}</label><textarea id="help-ai-question" rows="3" required class="w-full rounded-xl border border-base-300 bg-base-100 p-3 text-sm outline-none focus:border-primary focus:ring-2 focus:ring-primary/10" placeholder="{{ 'reading.ai_question' | t }}" data-ai-search-target="input">{{ keywords | escape_once }}</textarea><button type="submit" class="help-button mt-3 w-full" data-ai-search-target="submit">{{ 'reading.ai_ask' | t }}{% render 'icon', name: 'arrow-right', class: 'size-4' %}</button></form>
    <p class="mt-4 text-xs leading-5 text-base-content/40">{{ 'reading.ai_disclaimer' | t }}</p>
  </div>
</section>
