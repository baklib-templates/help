{
  "name": "baklib-help",
  "version": "3.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i ./src/stylesheets/application.css -o ./assets/stylesheets/application.css --minify",
    "build:js": "esbuild ./src/javascripts/application.js --bundle --minify --target=es2020 --outfile=./assets/javascripts/application.js",
    "test": "node --test src/javascripts/tests/*.test.js"
  },
  "dependencies": {
    "@hotwired/stimulus": "3.2.2",
    "marked": "16.4.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.1.4",
    "daisyui": "5.5.20",
    "esbuild": "0.25.9",
    "jsdom": "24.1.3",
    "tailwindcss": "4.1.4"
  }
}
