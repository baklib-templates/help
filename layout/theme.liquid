<!doctype html>
<html lang="{{ site.language | escape }}">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="turbo-prefetch" content="false">
    {% meta_tags %}
    {% render 'theme_colors' %}
    <script>
      (() => {
        let theme;
        try { theme = localStorage.getItem('help-theme'); } catch (_) {}
        document.documentElement.dataset.theme = theme === 'light' || theme === 'dark' ? theme : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      })();
    </script>
    {{ 'baklib/shared/main.css' | asset_url | stylesheet_tag: data-turbo-track: 'reload' }}
    {{ 'stylesheets/application.css' | asset_url | stylesheet_tag: data-turbo-track: 'reload' }}
    {{ 'baklib/shared/main.js' | asset_url | script_tag: data-turbo-track: 'reload' }}
    {{ 'javascripts/application.js' | asset_url | script_tag: defer: true, data-turbo-track: 'reload' }}
  </head>
  <body data-controller="help-ui" data-help-ui-image-close-value="{{ 'shell.close' | t | escape }}" data-help-ui-image-open-value="{{ 'shell.view_image' | t | escape }}">
    <a class="help-skip-link" href="#main-content">{{ 'shell.skip_content' | t }}</a>
    {% render 'header', page: page %}
    <main id="main-content" tabindex="-1">{{ content_for_layout }}</main>
    {% render 'footer' %}
  </body>
</html>
